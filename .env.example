# ──────────────────────────────────────────────
#  Galaxy Welcome Bot — Environment Variables
# ──────────────────────────────────────────────

# Your bot token (from https://discord.com/developers/applications)
BOT_TOKEN=your_bot_token_here

# Your bot's application/client ID
CLIENT_ID=your_client_id_here

# Your Discord user ID (for owner-only commands)
OWNER_ID=your_user_id_here

# SQLite database file path (optional — defaults to ./data/galaxy.db)
# DB_PATH=./data/galaxy.db
